{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumpa",
  "version": "1.0.8",
  "identifier": "com.songz.rabbit-desk-pet",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lumpa",
        "width": 1180,
        "height": 760,
        "maximized": false,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' data: blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "freezePrototype": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "rabbit-desk-pet"
        ]
      }
    },
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "shortDescription": "Lumpa",
    "longDescription": "Lumpa is a desktop companion app with chat, voice, pet actions, local usage statistics, and per-pet settings."
  }
}
