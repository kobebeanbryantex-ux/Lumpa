{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumpa Dev",
  "identifier": "com.songz.lumpa.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumpa Dev",
        "width": 1180,
        "height": 760,
        "maximized": true,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lumpa-dev"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
