# Public API settings
NODE_ENV=production
HOST=0.0.0.0
PORT=8090
LUMPA_PET_STORAGE_DIR=/data/pet-studio
LUMPA_PET_ALLOWED_ORIGINS=https://lumpa-pet-studio.wxxex.chatgpt.site
LUMPA_PET_MAX_UPLOAD_MB=12

# disabled is safe for first boot: it accepts no generation request as completed.
# webhook forwards a private multipart request to your GPU inference service.
LUMPA_PET_INFERENCE_MODE=disabled
LUMPA_PET_INFERENCE_URL=
LUMPA_PET_INFERENCE_TOKEN=
